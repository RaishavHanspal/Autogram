# ---------------------------------------------------------------------------
# autogram secrets — copy to .env and fill in. NEVER commit .env.
# Only credentials live here. All non-secret config is in config/config.yaml.
# ---------------------------------------------------------------------------

# Which posting backend to use for the SINGLE implicit account: "instagrapi"
# (private API), "graph" (official Instagram), or "youtube" (official YouTube).
# Ignored when AUTOGRAM_ACCOUNTS defines accounts (each account sets its own).
POST_BACKEND=instagrapi

# --- Multiple accounts in one repo (optional) ---
# A JSON array of per-account credentials, matched to config.yaml `accounts:` by
# `id`. This is how you link several IG/YouTube accounts to ONE repo without the
# flat env-var names below colliding. Keep it a single-line secret. Example:
#   AUTOGRAM_ACCOUNTS=[{"id":"romance","ig_username":"u","ig_session_b64":"b64"},{"id":"shorts","youtube_client_id":"..","youtube_client_secret":"..","youtube_refresh_token":".."}]
# Leave unset to use the flat IG_*/YOUTUBE_* vars below as one account.
AUTOGRAM_ACCOUNTS=

# --- instagrapi backend (private API — violates IG ToS, use a burner account) ---
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
# Base64-encoded session settings JSON. Seed once from a local login (see README).
# Strongly recommended: avoids a fresh password login (and challenges) every run.
IG_SESSION_B64=
# Optional proxy, e.g. http://user:pass@host:port
IG_PROXY=

# --- graph backend (official Instagram Graph API) ---
# Long-lived access token for an IG Business/Creator account linked to a FB Page.
IG_ACCESS_TOKEN=
# Numeric Instagram user id of that business account.
IG_USER_ID=

# --- GitHub (only needed for the GraphApiPoster default image host) ---
# In GitHub Actions this is injected automatically as GITHUB_TOKEN.
GITHUB_TOKEN=
# owner/repo used to publish release assets as public image URLs.
GITHUB_REPOSITORY=

# --- YouTube Shorts backend (official YouTube Data API OAuth) ---
# Set POST_BACKEND=youtube. Create these in Google Cloud and keep them secret.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Long-lived OAuth token with https://www.googleapis.com/auth/youtube.upload.
YOUTUBE_REFRESH_TOKEN=
# --- Ollama (LLM runtime) ---
# If a daemon is already running elsewhere, point at it; otherwise autogram
# starts its own on this host/port.
OLLAMA_HOST=http://127.0.0.1:11434
